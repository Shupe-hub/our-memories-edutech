# Railway production variables. Add the real values in Railway's Variables tab only.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
NODE_ENV=production
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
CLIENT_URL=https://your-frontend-domain.example
CORS_ORIGINS=https://your-frontend-domain.example
TRUST_PROXY_HOPS=1

SYSTEM_ADMIN_NAME=System
SYSTEM_ADMIN_SURNAME=Administrator
SYSTEM_ADMIN_EMAIL=admin@example.com
SYSTEM_ADMIN_PASSWORD=replace-with-a-unique-password-of-at-least-12-characters

RESEND_API_KEY=
EMAIL_FROM="Our Memories EduTech <noreply@example.com>"
EMAIL_REPLY_TO=
APP_PUBLIC_URL=https://your-frontend-domain.example
EMAIL_LOGO_URL=https://your-frontend-domain.example/our-memories-edutech-logo.png

# Attach a Railway persistent volume at this mount path.
APPLICATION_STORAGE_PATH=/app/private-documents
APPLICATION_MAX_FILE_BYTES=5242880
APPLICATION_DOCUMENT_RETENTION_DAYS=365
