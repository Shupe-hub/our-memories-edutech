NODE_ENV=production
DATABASE_PROVIDER=mysql
DATABASE_URL=mysql://<DB_USER>:<URL_ENCODED_PASSWORD>@localhost:3306/<DB_NAME>
JWT_SECRET=<RANDOM_SECRET_AT_LEAST_32_CHARACTERS>
CORS_ORIGINS=https://<FRONTEND_DOMAIN>,https://www.<FRONTEND_DOMAIN>
# Optional: set only to the proxy hop count confirmed by CyberCircuit.
TRUST_PROXY_HOPS=<PROXY_HOP_COUNT>
# Set this to a persistent path outside public_html.
APPLICATION_STORAGE_PATH=/home/<CPANEL_USER>/private/our-memories-documents
APPLICATION_MAX_FILE_BYTES=5242880
APPLICATION_DOCUMENT_RETENTION_DAYS=365
SYSTEM_ADMIN_NAME=<INITIAL_ADMIN_NAME>
SYSTEM_ADMIN_SURNAME=<INITIAL_ADMIN_SURNAME>
SYSTEM_ADMIN_EMAIL=<UNIQUE_ADMIN_EMAIL>
SYSTEM_ADMIN_PASSWORD=<UNIQUE_PASSWORD_AT_LEAST_12_CHARACTERS>
RESEND_API_KEY=<RESEND_API_KEY>
EMAIL_FROM=Our Memories EduTech <noreply@<VERIFIED_SENDER_DOMAIN>>
EMAIL_REPLY_TO=<MONITORED_SUPPORT_EMAIL>
APP_PUBLIC_URL=https://<FRONTEND_DOMAIN>
EMAIL_LOGO_URL=https://<FRONTEND_DOMAIN>/our-memories-edutech-logo.png
# PORT is assigned by cPanel/Passenger. Do not set a fixed port in the UI.
