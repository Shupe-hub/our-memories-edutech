# Local Windows development only. Copy to .env.development and set the local PostgreSQL credentials.
DATABASE_URL=postgresql://postgres:CHANGE_ME@127.0.0.1:5432/our_memories_edutech_dev?schema=public
NODE_ENV=development
JWT_SECRET=replace-with-a-random-local-secret-at-least-32-characters
CLIENT_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173
TRUST_PROXY_HOPS=0
PORT=5000

SYSTEM_ADMIN_NAME=Local
SYSTEM_ADMIN_SURNAME=Administrator
SYSTEM_ADMIN_EMAIL=admin@local.test
SYSTEM_ADMIN_PASSWORD=replace-with-a-unique-local-password-of-at-least-12-characters

# Keep empty to disable real mail during local development.
RESEND_API_KEY=
EMAIL_FROM="Our Memories EduTech <noreply@example.test>"
EMAIL_REPLY_TO=
APP_PUBLIC_URL=https://localhost:5173
EMAIL_LOGO_URL=https://localhost:5173/our-memories-edutech-logo.png

# Blank uses the private backend/.private-application-documents directory locally.
APPLICATION_STORAGE_PATH=
APPLICATION_MAX_FILE_BYTES=5242880
APPLICATION_DOCUMENT_RETENTION_DAYS=365
